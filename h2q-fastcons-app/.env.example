NEXT_PUBLIC_APP_NAME=H2Q FastCons

# Supabase — đăng nhập, dữ liệu, ảnh
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Chỉ server. Cần để admin tạo, sửa mật khẩu và xóa tài khoản. Không thêm NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-secret-key

# Tuỳ chọn. Chỉ server đọc. Có đủ 5 biến thì ảnh và tệp lên Cloudflare R2.
# Thiếu thì hệ thống vẫn lưu, xếp cùng thư mục logic trong Supabase.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Tuỳ chọn. Chỉ server đọc. Bỏ trống nếu chưa dùng Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
