# Public Frappe site (used only for display / absolute asset hints)
NEXT_PUBLIC_FRAPPE_URL=https://dev.h2q.com.vn
NEXT_PUBLIC_APP_NAME=H2Q FastCons

# Server-side proxy target (Vercel env). Falls back to NEXT_PUBLIC_FRAPPE_URL.
FRAPPE_URL=https://dev.h2q.com.vn

# Optional service account for webhook/cron sync (no browser sid)
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# Supabase — offline buffer + Realtime dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only (Vercel secrets) — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for Database Webhook / cron → /api/sync/*
SYNC_WEBHOOK_SECRET=change-me
